# ─────────────────────────────────────────────────────────────────────────────
# Copy this to .env and fill in the blanks.
#
#     cp .env.example .env
#
# Only the first section is required to get running. Everything below it has a
# sensible default, and the app tells you at startup if something is missing —
# all of it at once, not one restart at a time.
# ─────────────────────────────────────────────────────────────────────────────


# ── Required ─────────────────────────────────────────────────────────────────

# Your Postgres. Grab a free one at neon.tech in about two minutes.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 'pg' for a normal Postgres (this is what you want).
# 'neon' only if your network blocks port 5432 — some antivirus and ISPs do.
#   Same database either way, just tunnelled over WebSocket on 443 instead.
DATABASE_DRIVER=pg

# For AI matching. Without it the system still works — it falls back to
# deterministic scoring — it just gets a bit less clever.
ANTHROPIC_API_KEY=

# For semantic search. OpenAI key.
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_API_KEY=


# ── No email ─────────────────────────────────────────────────────────────────
#
# There isn't any. This system has no email transport, no provider key and no
# recipient address — the jobs live on the dashboard and that is the whole
# delivery mechanism. Nothing here can send you anything.


# ── Required in production only ──────────────────────────────────────────────
#
# Ignored while NODE_ENV=development. The app refuses to boot without them in
# production, on purpose.

# openssl rand -base64 32
AUTH_SECRET=

# openssl rand -base64 24  — must be different from AUTH_SECRET
OPS_PASSWORD=

# openssl rand -base64 32  — signs the "not interested" links in your emails
FEEDBACK_TOKEN_SECRET=


# ── Optional ─────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true

# Be polite to the job boards you scrape. Some will ask who you are.
CRAWLER_USER_AGENT=JobIntelBot/1.0
# CRAWLER_CONTACT_EMAIL=you@example.com

# Bumps up GitHub API rate limits when reading your portfolio.
# GITHUB_TOKEN=

WORKER_CONCURRENCY=4
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000

# Local embedded Postgres, if you'd rather not use Neon. See the README.
# PGLITE_DATA_DIR=./.pgdata
